# Nusxa oling: cp .env.example .env  — keyin keraklilarini toʻldiring. .env gitga tushmaydi.
# Kalit qoʻshgach: npm run verify-tts  (ovoz haqiqatan ishlashini tekshiradi)

# Azure AI Speech — uz-UZ-MadinaNeural (ayol), uz-UZ-SardorNeural (erkak) ovozlari shu yerda ham bor
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=          # masalan: westeurope

# Google Cloud Text-to-Speech — tillar API dan jonli olinadi (oʻzbekcha boʻlmasa, roʻyxatda chiqmaydi)
GOOGLE_TTS_API_KEY=

# ElevenLabs — ayol va erkak ovoz ID larini ElevenLabs kabinetidan oling
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Ixtiyoriy: render uchun Chromium yoʻli (boʻlmasa Remotion oʻzi yuklab oladi)
REMOTION_BROWSER=
PORT=3000
